MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/dino-link-catalog?retryWrites=true&w=majority
PORT=3000

# ใช้สำหรับเซ็น/ตรวจสอบ JWT — ต้องเป็นค่าสุ่มที่ยาวและคาดเดายาก ห้ามใช้ค่าตัวอย่างนี้จริง
# สร้างค่าใหม่ได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ใช้ตอนรัน `npm run seed:admin` เพื่อสร้าง Admin คนแรกเท่านั้น ไม่ได้ใช้ตอนรันเซิร์ฟเวอร์ปกติ
# ADMIN_EMAIL จะถูกเพิ่มเข้า Email Whitelist ให้อัตโนมัติตอน seed ไม่งั้น admin คนแรกจะ login เข้าเว็บเองไม่ได้
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
